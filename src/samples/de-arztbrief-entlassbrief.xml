          <code code="10183-2" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Medikamente bei Entlassung"/>
          <title>Entlassmedikation</title>
          <text>
            <table>
              <thead><tr><th>Wirkstoff</th><th>Dosierung</th><th>Hinweis</th></tr></thead>
              <tbody>
                <tr><td>Beispiel-Wirkstoff A (Antibiotikum)</td><td>1-0-1</td><td>noch 4 Tage</td></tr>
                <tr><td>Beispiel-Wirkstoff B (Blutdrucksenker)</td><td>1-0-0</td><td>unverändert fortführen</td></tr>
              </tbody>
            </table>
          </text>
        </section>
